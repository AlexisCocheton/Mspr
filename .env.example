# Copier ce fichier en .env (ignoré par Git) pour personnaliser la stack docker-compose.
POSTGRES_DB=mecha
POSTGRES_USER=mecha
POSTGRES_PASSWORD=changez-moi

# URL appelée en POST (JSON) à chaque nouvelle alerte (ticketing, SCADA, messagerie).
# Vide = alertes visibles dans le dashboard et journalisées par l'API uniquement.
MECHA_ALERT_WEBHOOK_URL=
